# Office AI Assistant backend configuration

# Server
PORT=3456
NODE_ENV=production
PUBLIC_DIR=../

# Authentication
# Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/app.db

# CORS
# For production, set this to the public task pane origin.
# Example: https://633qaq.github.io
CORS_ORIGIN=https://633qaq.github.io

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=info

# Uploads
MAX_UPLOAD_SIZE=10

# AI provider keys for server mode
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Local or private Ollama host. Public deployments usually leave this unset
# unless the backend can safely reach that Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# Default provider used when the frontend does not specify one.
DEFAULT_AI_PROVIDER=gemini
